# Development only. Do not commit a real bootstrap token or copy this file to production unchanged.
NABARBEARIA_BIND=127.0.0.1:3001
NABARBEARIA_DB_PATH=backend/data/nabarbearia.db
NABARBEARIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NABARBEARIA_SECURE_COOKIES=false
NABARBEARIA_SESSION_DAYS=7
NABARBEARIA_TIMEZONE=America/Sao_Paulo

# Required at runtime. Generate a fresh 32-byte token with a CSPRNG and inject it as a secret.
# NABARBEARIA_BOOTSTRAP_TOKEN=
