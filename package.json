{
  "name": "na-barbearia-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "android:init": "node scripts/tauri-android.mjs init --ci --skip-targets-install",
    "android:signing": "node scripts/android-signing.mjs",
    "android:build": "npm run android:signing && node scripts/tauri-android.mjs build --apk --target aarch64",
    "android:build:debug": "node scripts/tauri-android.mjs build --debug --apk --target aarch64",
    "android:serve": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "dev": "vite",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:client-flow": "npm run build && node scripts/check-client-flow.mjs",
    "test:owner-flow": "npm run build && node scripts/check-owner-flow.mjs",
    "test:barber-responsive": "npm run build && node scripts/check-barber-responsive.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
