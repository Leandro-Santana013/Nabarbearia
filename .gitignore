# Dependências e artefatos de compilação não são código-fonte e excedem os
# limites práticos do GitHub quando versionados.
node_modules/
backend/target/
portable/release/
artifacts/
.slim/
*.keystore
*.jks
*.p12

# Segredos locais; o arquivo de exemplo permanece versionado.
.env
.env.*
!*.env.example

# Arquivos temporários do SQLite em execução.
*.db-wal
*.db-shm
__pycache__/
*.pyc
