{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Temporary clean failed flow artifacts",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"require('node:fs').rmSync('C:\\\\Users\\\\Santana\\\\AppData\\\\Local\\\\Temp\\\\na-owner-flow-SCYJmh', { recursive: true, force: true })"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Temporary clean flow folder",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require(\"node:fs\");fs.rmSync(\"C:\\\\Users\\\\Santana\\\\AppData\\\\Local\\\\Temp\\\\na-owner-flow-SCYJmh\",{recursive:true,force:true})"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Nabarbearia local",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Nabarbearia backend local",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:backend"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Inspect local backend PID",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process -Name nabarbearia-backend | Select-Object -ExpandProperty Id"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check local origin setting",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"if (Select-String -Path 'backend/.env' -Pattern '^NABARBEARIA_ALLOWED_ORIGINS=' -Quiet) { Write-Output 'Configured' } else { Write-Output 'Not configured' }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Allow local Vite origin",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Add-Content -LiteralPath 'backend/.env' -Value 'NABARBEARIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175'; Stop-Process -Id 13284 -Force; Write-Output 'Origin configured; backend stopped for restart.'"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restart Nabarbearia backend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:backend"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Verify local origin config",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Select-String -Path 'backend/.env' -Pattern '^NABARBEARIA_ALLOWED_ORIGINS=' | ForEach-Object { $_.Line }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Configure local frontend origin",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"scripts/configure-local-origin.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find backend process to restart",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process -Name nabarbearia-backend | Select-Object -ExpandProperty Id"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restart backend with local origin",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Stop-Process -Id 24528 -Force"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start backend with fixed origin",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:backend"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Clean local environment config",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"scripts/clean-local-env.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build schedule centering fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}